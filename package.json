{
  "name": "whiteboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "preview": "vite preview",
    "build": "vite build",
    "deploy": "npm run build && wrangler d1 migrations apply DB --remote --config dist/server/wrangler.json && wrangler deploy",
    "typecheck": "tsr generate && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "test:worker": "node --test tests/local-worker.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "better-auth": "^1.7.25",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "geist": "^1.9.2",
    "lucide-react": "^1.75.0",
    "nanoid": "^6.0.2",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.0",
    "@cloudflare/workers-types": "^5.20261118.1",
    "@eslint/js": "^10.0.1",
    "@tanstack/router-cli": "^1.168.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  },
  "cloudflare": {
    "bindings": {
      "BETTER_AUTH_SECRET": {
        "description": "Required. Paste the output of `openssl rand -hex 32`."
      },
      "BETTER_AUTH_URL": {
        "description": "Required. Enter the deployed app’s public HTTPS origin, without a path."
      },
      "GOOGLE_CLIENT_ID": {
        "description": "Optional Google OAuth client ID."
      },
      "GOOGLE_CLIENT_SECRET": {
        "description": "Optional Google OAuth client secret."
      }
    }
  },
  "license": "MIT"
}
